{
  "id": "routines",
  "contexts": ["household", "shared_space"],
  "name": "Routines",
  "version": "1.2.0",
  "description": "Reusable household playbooks for mornings, bedtime, travel prep, weekly resets, and share-safe caregiver instructions.",
  "entrypoint": "index.html",
  "runtime": "static",
  "category": "family",
  "tags": [
    "routines",
    "checklists",
    "caregiver",
    "kids",
    "household",
    "playbooks"
  ],
  "data_access": {
    "reads": [
      "family.members",
      "family.groups",
      "family.documents"
    ],
    "writes": []
  },
  "permissions": {
    "default_audience": "everyone",
    "requires_approval": false
  },
  "storage": "db",
  "preload": {
    "templates": {"sql": "SELECT * FROM app_routines__templates ORDER BY created_at DESC"},
    "template_steps": {"sql": "SELECT * FROM app_routines__template_steps ORDER BY sort_order ASC"},
    "runs": {"sql": "SELECT r.*, d.title AS detail_title, d.caregiver_label AS detail_caregiver_label, d.notes AS detail_notes FROM app_routines__runs r LEFT JOIN app_routines__run_details d ON d.run_id = r.id WHERE r.status = 'active' ORDER BY r.started_at DESC"},
    "run_steps": {"sql": "SELECT s.* FROM app_routines__run_steps s JOIN app_routines__runs r ON r.id = s.run_id AND r.status = 'active' ORDER BY s.sort_order ASC"},
    "caregiver_packets": {"sql": "SELECT * FROM app_routines__caregiver_packets ORDER BY created_at DESC"},
    "caregiver_packet_steps": {"sql": "SELECT * FROM app_routines__caregiver_packet_steps ORDER BY sort_order ASC"}
  },
  "db_encryption": "default",
  "db_plaintext_columns": [
    "category",
    "visibility",
    "household_id",
    "target_member_id",
    "assigned_member_id",
    "completed_by_member_id",
    "required",
    "sort_order",
    "timer_minutes",
    "run_date",
    "status",
    "template_id",
    "run_id",
    "packet_id",
    "source_step_id",
    "include_contacts",
    "include_health_notes",
    "include_documents",
    "created_at",
    "updated_at",
    "started_at",
    "completed_at",
    "canceled_at",
    "archived_at",
    "restricted"
  ],
    "member_references": {
      "templates": [
        {
          "column": "owner_member_id",
          "on_removed": "keep"
        },
        {
          "column": "target_member_id",
          "on_removed": "null"
        }
      ],
      "template_steps": [
        {
          "column": "assigned_member_id",
          "on_removed": "null"
        },
        {
          "column": "created_by_member_id",
          "on_removed": "keep"
        }
      ],
      "template_audience": [
        {
          "column": "member_id",
          "on_removed": "delete"
        },
        {
          "column": "created_by_member_id",
          "on_removed": "keep"
        }
      ],
      "runs": [
        {
          "column": "started_by_member_id",
          "on_removed": "keep"
        },
        {
          "column": "target_member_id",
          "on_removed": "null"
        }
      ],
      "run_details": [
        {
          "column": "started_by_member_id",
          "on_removed": "keep"
        }
      ],
      "run_steps": [
        {
          "column": "assigned_member_id",
          "on_removed": "null"
        },
        {
          "column": "completed_by_member_id",
          "on_removed": "keep"
        }
      ],
      "caregiver_packets": {
        "column": "created_by_member_id",
        "on_removed": "keep"
      }
    },
  "row_policies": {
    "templates": {
      "kind": "owner_or_visibility",
      "member_column": "owner_member_id",
      "visibility_column": "visibility",
      "everyone_values": [
        "everyone"
      ],
      "adult_values": [
        "adults"
      ]
    },
    "template_steps": {
      "kind": "inherit_visibility",
      "fk_column": "template_id",
      "parent_table": "templates",
      "writer_column": "created_by_member_id",
      "adults_bypass": true
    },
    "template_audience": {
      "kind": "inherit_visibility",
      "fk_column": "template_id",
      "parent_table": "templates",
      "writer_column": "created_by_member_id",
      "adults_bypass": true
    },
    "runs": {
      "kind": "adult_writable",
      "retain_days": {
        "default": 365,
        "timestamp_column": "started_at",
        "override_key": "run_history",
        "dependent_tables": [
          { "table": "run_steps", "foreign_key": "run_id" },
          { "table": "run_details", "foreign_key": "run_id" }
        ]
      }
    },
    "run_details": {
      "kind": "owner_or_visibility",
      "member_column": "started_by_member_id",
      "visibility_column": "visibility",
      "everyone_values": ["everyone"],
      "adult_values": ["adults"]
    },
    "run_steps": {
      "kind": "owner_only",
      "member_column": "assigned_member_id",
      "adults_bypass": true
    },
    "caregiver_packets": {
      "kind": "adult_only"
    },
    "caregiver_packet_steps": {
      "kind": "adult_only"
    }
  },
  "publishes": [
    "routine.started",
    "routine.completed",
    "routine.step_completed"
  ],
  "alert_on": [
    "routine.completed"
  ],
  "nav": {
    "label": "Routines"
  },
  "kiosk": "allow",
  "kiosk_checklist": {
    "table": "run_steps",
    "label": "Routines",
    "title_column": "title_snapshot",
    "icon_column": "icon_snapshot",
    "sort_column": "sort_order",
    "member_column": "assigned_member_id",
    "timer_column": "timer_minutes",
    "done_by_id_column": "completed_by_member_id",
    "completed_at_column": "completed_at",
    "status": {
      "column": "status",
      "done_value": "done",
      "pending_value": "pending"
    },
    "parent": {
      "table": "runs",
      "fk_column": "run_id",
      "title_column": "title_snapshot",
      "filter": [
        { "column": "status", "equals": "active" },
        { "column": "run_date", "equals": ":today" }
      ]
    },
    "display": "tiles",
    "authorization": "avatar",
    "audit": "member"
  },
  "widget": {
    "label": "Routines",
    "size": "small"
  },
  "agenda": {
    "kind": "routine",
    "source": {
      "kind": "sql",
      "query": "SELECT r.id AS id, COALESCE(d.title, r.title_snapshot) AS title, r.run_date AS when_at, r.target_member_id AS member_id FROM app_routines__runs r LEFT JOIN app_routines__run_details d ON d.run_id = r.id WHERE r.run_date = :today AND r.status = 'active' AND (r.restricted = 0 OR d.id IS NOT NULL) ORDER BY r.started_at LIMIT 10"
    }
  },
  "glance": {
    "source": {
      "kind": "sql",
      "query": "SELECT COUNT(*) AS n FROM app_routines__runs r LEFT JOIN app_routines__run_details d ON d.run_id = r.id WHERE r.run_date = :today AND r.status = 'active' AND (r.restricted = 0 OR d.id IS NOT NULL) LIMIT 1"
    },
    "display": {
      "template": "badge",
      "count": "n",
      "label": "routines in progress",
      "severity": "info"
    }
  },
  "resource_limits": {
    "max_db_bytes": 52428800
  },
  "icon": "\ud83e\udded"
}

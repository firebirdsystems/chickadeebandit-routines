{
  "scenarios": [
    {
      "name": "a child reads the household templates but is offered no template or packet controls",
      "members": {
        "parent": "adult",
        "kid": "child"
      },
      "steps": [
        {
          "action": "seedRaw",
          "sql": "INSERT INTO app_routines__templates (id, title, category, visibility, owner_member_id, created_at, updated_at) VALUES ('ui-t1', ?, 'household', 'everyone', ?, datetime('now'), datetime('now'))",
          "params": [
            "Morning launch",
            "{{parent}}"
          ]
        },
        {
          "action": "seedRaw",
          "sql": "INSERT INTO app_routines__template_steps (id, template_id, title, sort_order, required, created_at, updated_at) VALUES ('ui-s1', 'ui-t1', ?, 1, 1, datetime('now'), datetime('now'))",
          "params": [
            "Pack the bag"
          ]
        },
        {
          "action": "open",
          "as": "kid"
        },
        {
          "action": "expectVisible",
          "as": "kid",
          "selector": "[data-testid=\"tab-templates\"]"
        },
        {
          "action": "click",
          "as": "kid",
          "selector": "[data-testid=\"tab-templates\"]"
        },
        {
          "action": "expectVisible",
          "as": "kid",
          "selector": "[data-testid=\"template-card\"][data-template-id=\"ui-t1\"]"
        },
        {
          "action": "expectCount",
          "as": "kid",
          "selector": "[data-testid=\"template-actions\"]",
          "count": 0
        },
        {
          "action": "expectCount",
          "as": "kid",
          "selector": "[data-testid=\"new-template\"]",
          "count": 0
        },
        {
          "action": "click",
          "as": "kid",
          "selector": "[data-testid=\"tab-packets\"]"
        },
        {
          "action": "expectVisible",
          "as": "kid",
          "selector": "[data-testid=\"packets-locked\"]"
        },
        {
          "action": "open",
          "as": "parent"
        },
        {
          "action": "expectVisible",
          "as": "parent",
          "selector": "[data-testid=\"new-template\"]"
        },
        {
          "action": "click",
          "as": "parent",
          "selector": "[data-testid=\"tab-templates\"]"
        },
        {
          "action": "expectVisible",
          "as": "parent",
          "selector": "[data-testid=\"template-card\"][data-template-id=\"ui-t1\"]"
        },
        {
          "action": "expectVisible",
          "as": "parent",
          "selector": "[data-testid=\"template-actions\"][data-template-id=\"ui-t1\"]"
        },
        {
          "action": "click",
          "as": "parent",
          "selector": "[data-testid=\"tab-packets\"]"
        },
        {
          "action": "expectVisible",
          "as": "parent",
          "selector": "[data-testid=\"new-packet\"]"
        }
      ]
    },
    {
      "name": "a child sees their step of an adults-only run, but not the run's title; an adult sees the title",
      "members": {
        "parent": "adult",
        "kid": "child"
      },
      "steps": [
        {
          "action": "seedRaw",
          "sql": "INSERT INTO app_routines__templates (id, title, category, visibility, owner_member_id, created_at, updated_at) VALUES ('ui-t2', ?, 'household', 'adults', ?, datetime('now'), datetime('now'))",
          "params": [
            "Surprise party prep",
            "{{parent}}"
          ]
        },
        {
          "action": "seedRaw",
          "sql": "INSERT INTO app_routines__runs (id, template_id, title_snapshot, run_date, status, started_by_member_id, caregiver_label, notes, started_at, restricted) VALUES ('ui-r2', 'ui-t2', '', date('now'), 'active', ?, '', '', datetime('now'), 1)",
          "params": [
            "{{parent}}"
          ]
        },
        {
          "action": "seedRaw",
          "sql": "INSERT INTO app_routines__run_details (id, run_id, started_by_member_id, visibility, title, caregiver_label, notes, created_at) VALUES ('ui-r2', 'ui-r2', ?, 'adults', ?, ?, '', datetime('now'))",
          "params": [
            "{{parent}}",
            "Surprise party prep",
            "Aunt Jo"
          ]
        },
        {
          "action": "seedRaw",
          "sql": "INSERT INTO app_routines__run_steps (id, run_id, title_snapshot, assigned_member_id, sort_order, required, status) VALUES ('ui-rs2', 'ui-r2', ?, ?, 0, 1, 'pending')",
          "params": [
            "Blow up balloons",
            "{{kid}}"
          ]
        },
        {
          "action": "open",
          "as": "kid"
        },
        {
          "action": "expectText",
          "as": "kid",
          "text": "Blow up balloons"
        },
        {
          "action": "expectText",
          "as": "kid",
          "selector": "[data-testid=\"run-title\"][data-run-id=\"ui-r2\"]",
          "text": "Private routine"
        },
        {
          "action": "expectNoText",
          "as": "kid",
          "text": "Surprise party prep"
        },
        {
          "action": "expectNoText",
          "as": "kid",
          "text": "Aunt Jo"
        },
        {
          "action": "expectCount",
          "as": "kid",
          "selector": "[data-testid=\"start-routine\"]",
          "count": 0
        },
        {
          "action": "open",
          "as": "parent"
        },
        {
          "action": "expectText",
          "as": "parent",
          "selector": "[data-testid=\"run-title\"][data-run-id=\"ui-r2\"]",
          "text": "Surprise party prep"
        },
        {
          "action": "expectText",
          "as": "parent",
          "text": "Aunt Jo"
        },
        {
          "action": "expectVisible",
          "as": "parent",
          "selector": "[data-testid=\"start-routine\"]"
        }
      ]
    },
    {
      "name": "a guest starts a run of an everyone template, ticks a step, and is offered Finish",
      "members": {
        "parent": "adult",
        "sitter": "guest"
      },
      "steps": [
        {
          "action": "seedRaw",
          "sql": "INSERT INTO app_routines__templates (id, title, category, visibility, owner_member_id, created_at, updated_at) VALUES ('ui-t3', ?, 'household', 'everyone', ?, datetime('now'), datetime('now'))",
          "params": [
            "Bedtime",
            "{{parent}}"
          ]
        },
        {
          "action": "seedRaw",
          "sql": "INSERT INTO app_routines__template_steps (id, template_id, title, sort_order, required, created_at, updated_at) VALUES ('ui-s3a', 'ui-t3', ?, 1, 1, datetime('now'), datetime('now'))",
          "params": [
            "Brush teeth"
          ]
        },
        {
          "action": "seedRaw",
          "sql": "INSERT INTO app_routines__template_steps (id, template_id, title, sort_order, required, created_at, updated_at) VALUES ('ui-s3b', 'ui-t3', ?, 2, 1, datetime('now'), datetime('now'))",
          "params": [
            "Read a story"
          ]
        },
        {
          "action": "open",
          "as": "sitter"
        },
        {
          "action": "expectVisible",
          "as": "sitter",
          "selector": "[data-testid=\"start-routine\"]"
        },
        {
          "action": "expectCount",
          "as": "sitter",
          "selector": "[data-testid=\"new-template\"]",
          "count": 0
        },
        {
          "action": "click",
          "as": "sitter",
          "selector": "[data-testid=\"start-routine\"]"
        },
        {
          "action": "expectVisible",
          "as": "sitter",
          "selector": "#run-form button.primary"
        },
        {
          "action": "click",
          "as": "sitter",
          "selector": "#run-form button.primary"
        },
        {
          "action": "expectText",
          "as": "sitter",
          "text": "Bedtime",
          "selector": "[data-testid=\"run-title\"]"
        },
        {
          "action": "expectCount",
          "as": "sitter",
          "selector": "[data-testid=\"step-done\"]",
          "count": 2
        },
        {
          "action": "click",
          "as": "sitter",
          "selector": ".steps > .step:nth-child(1) [data-testid=\"step-done\"]"
        },
        {
          "action": "expectText",
          "as": "sitter",
          "text": "1/2 done"
        },
        {
          "action": "expectCount",
          "as": "sitter",
          "selector": "[data-testid=\"own-progress\"]",
          "count": 0
        },
        {
          "action": "expectVisible",
          "as": "sitter",
          "selector": "[data-testid=\"finish-run\"]"
        },
        {
          "action": "expectVisible",
          "as": "sitter",
          "selector": "[data-testid=\"cancel-run\"]"
        }
      ]
    }
  ]
}
